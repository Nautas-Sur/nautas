---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../HeroSection.astro';
import CompassCard from '../CompassCard.astro';
import { sortCompass } from '../../lib/sortCompass';
import { em } from '../../lib/emphasis';

const locale = Astro.currentLocale || 'es';
const page = await getEntry('pages', 'brujula');
const d = page?.data;
const ui = await getEntry('ui', 'textos');
const t = (f?: { es: string; en: string }) => f?.[locale] || undefined;

const items = sortCompass(await getCollection('compass'));
---

<BaseLayout
  title={t(d?.title) ?? ''}
  description={t(d?.description) ?? ''}
  locale={locale}
>
  <HeroSection
    variant="default"
    title={em(t(d?.hero_title)) ?? ''}
    subtitle={em(t(d?.hero_subtitle))}
    subtitleReadMore={true}
    readMoreLabel={t(ui?.data.read_more) ?? (locale === 'en' ? 'read more' : 'leer más')}
    readLessLabel={t(ui?.data.read_less) ?? (locale === 'en' ? 'read less' : 'leer menos')}
  />

  {items.length > 0 && (
    <section class="max-w-[1440px] mx-auto px-6 md:px-12 mb-section">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {items.map((i) => (
          <CompassCard
            name={i.data.name}
            presentation={locale === 'en' ? i.data.presentation.en : i.data.presentation.es}
            image={i.data.image}
            imageAlt={i.data.imageAlt || i.data.name}
            link={i.data.link}
            locale={locale}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
