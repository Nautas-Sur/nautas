---
import { em } from '../lib/emphasis';

export interface Trailer {
  videoId: string;
  label?: string;
  title?: string;
  active?: boolean;
}

export interface Episode {
  number: number;
  title: string;
  description?: string;
  videoId?: string;
  active?: boolean;
}

export interface Props {
  episodes: Episode[];
  trailer?: Trailer;
  playlistId?: string;
  title?: string;
  countLabel?: string;
  separatorLabel?: string;
  episodeLabel?: string;
  nowPlayingLabel?: string;
  locale?: string;
}

const { episodes, trailer, playlistId, title, countLabel, separatorLabel, episodeLabel, nowPlayingLabel, locale = 'es' } = Astro.props;
---

<div class="space-y-5">
  {(title || countLabel) && (
    <div class="flex items-end justify-between gap-4 pb-3 border-b border-on-surface/[0.08]">
      {title && (
        <h2 class="font-headline text-2xl md:text-3xl text-on-surface leading-tight">
          {title}
        </h2>
      )}
      {countLabel && (
        <span class="font-bitacora text-[10px] text-warm uppercase tracking-[0.2em] whitespace-nowrap pb-1">
          // {countLabel}
        </span>
      )}
    </div>
  )}

  {/* Trailer */}
  {trailer && (
    <div
      class="trailer-item group rounded-xl transition-all cursor-pointer overflow-hidden border"
      role="button"
      tabindex="0"
      aria-current={trailer.active ? 'true' : undefined}
      data-video-id={trailer.videoId}
      data-is-trailer="true"
    >
      {/* Thumbnail */}
      <div class="relative w-full overflow-hidden" style="aspect-ratio:16/9">
        <img
          src={`https://img.youtube.com/vi/${trailer.videoId}/mqdefault.jpg`}
          alt=""
          loading="lazy"
          class="w-full h-full object-cover opacity-70 group-hover:opacity-95 group-hover:scale-105 transition-all duration-500"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-surface-container-low/90 via-surface-container-low/20 to-transparent pointer-events-none"
          aria-hidden="true"
        ></div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-warm/[0.06] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
          aria-hidden="true"
        ></div>

        {/* Chip adelanto */}
        <div class="absolute bottom-2.5 right-2.5 flex items-center gap-1.5">
          <span class="font-bitacora text-[9px] text-warm uppercase tracking-[0.15em] bg-background/70 backdrop-blur px-2 py-0.5 rounded-full border border-warm/30">
            // {trailer.label ?? (locale === 'en' ? 'trailer' : 'adelanto')}
          </span>
          <span
            class="material-symbols-outlined text-2xl text-warm drop-shadow-md group-hover:scale-110 transition-transform"
            style="font-variation-settings:'FILL' 1;"
          >
            play_circle
          </span>
        </div>
      </div>

      {/* Content */}
      <div class="p-4 md:p-5">
        <h3 class="trailer-title font-headline text-base md:text-lg leading-tight transition-colors">
          {trailer.title ?? (locale === 'en' ? 'Trailer' : 'Adelanto')}
        </h3>
      </div>
    </div>
  )}

  {/* Separator */}
  {trailer && episodes.length > 0 && (
    <div class="flex items-center gap-3 pt-1">
      <span class="font-bitacora text-[10px] text-warm uppercase tracking-[0.2em]">
        // {separatorLabel ?? (locale === 'en' ? 'episodes' : 'episodios')}
      </span>
      <div class="flex-1 h-px bg-on-surface/[0.08]"></div>
    </div>
  )}

  <div class="space-y-2 max-h-[680px] overflow-y-auto pr-1 scrollbar-thin">
    {episodes.map((ep, i) => (
      <div
        class="episode-item group rounded-xl transition-all cursor-pointer overflow-hidden border"
        role="button"
        tabindex="0"
        aria-current={ep.active ? 'true' : undefined}
        data-video-id={ep.videoId ?? ''}
        data-index={i}
      >
        {/* Thumbnail */}
        {ep.videoId && (
          <div class="relative w-full overflow-hidden" style="aspect-ratio:16/9">
            <img
              src={`https://img.youtube.com/vi/${ep.videoId}/mqdefault.jpg`}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover opacity-70 group-hover:opacity-95 group-hover:scale-105 transition-all duration-500"
            />
            {/* Gradiente para legibilidad inferior */}
            <div
              class="absolute inset-0 bg-gradient-to-t from-surface-container-low/90 via-surface-container-low/20 to-transparent pointer-events-none"
              aria-hidden="true"
            ></div>

            {/* Overlay cálido sutil al hover */}
            <div
              class="absolute inset-0 bg-gradient-to-t from-warm/[0.06] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              aria-hidden="true"
            ></div>

            {/* Indicador de play en esquina inferior derecha */}
            <div class="absolute bottom-2.5 right-2.5 flex items-center gap-1.5">
              <span class="now-playing-badge font-bitacora text-[9px] text-warm uppercase tracking-[0.15em] bg-background/70 backdrop-blur px-2 py-0.5 rounded-full border border-warm/30">
                // {nowPlayingLabel ?? (locale === 'en' ? 'now playing' : 'reproduciendo')}
              </span>
              <span
                class="material-symbols-outlined text-2xl text-warm drop-shadow-md group-hover:scale-110 transition-transform"
                style="font-variation-settings:'FILL' 1;"
              >
                play_circle
              </span>
            </div>
          </div>
        )}

        {/* Content */}
        <div class="p-4 md:p-5">
          <div class="flex justify-between items-start mb-2 gap-3">
            <span class="ep-num font-bitacora text-[10px] tracking-[0.15em] uppercase">
              // {episodeLabel ?? (locale === 'en' ? 'episode' : 'episodio')} {String(ep.number).padStart(2, '0')}
            </span>
            {!ep.videoId && (
              <span class="material-symbols-outlined text-base text-on-surface/40 group-hover:text-warm transition-colors">
                play_circle
              </span>
            )}
          </div>

          <h3 class="ep-title font-headline text-base md:text-lg leading-tight mb-1.5 transition-colors">
            {ep.title}
          </h3>

          {ep.description && (
            <p class="text-xs text-on-surface-variant line-clamp-2 leading-relaxed font-body">
              <Fragment set:html={em(ep.description) ?? ''} />
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Scrollbar minimalista para la lista de episodios */
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 165, 116, 0.2) transparent;
  }
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(212, 165, 116, 0.2);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 165, 116, 0.4);
  }

  /* Estado activo: una sola fuente de verdad en el DOM (aria-current),
     y el CSS deriva todo lo demás. Antes cada elemento visual tenía que
     ser actualizado a mano por el script, y los que se olvidaban
     quedaban congelados en el estado del build. */

  .episode-item,
  .trailer-item {
    background-color: var(--color-surface-container-low);
    border-color: transparent;
  }

  .episode-item:hover,
  .trailer-item:hover {
    border-color: rgb(from var(--color-warm) r g b / 0.2);
    background-color: var(--color-surface-container-high);
    transform: translateY(-1px);
  }

  .episode-item[aria-current='true'],
  .trailer-item[aria-current='true'] {
    background-color: var(--color-surface-container-high);
    border-color: rgb(from var(--color-warm) r g b / 0.4);
    box-shadow: 0 8px 24px rgba(212, 165, 116, 0.08);
    transform: none;
  }

  .ep-num { color: rgb(from var(--color-on-surface) r g b / 0.4); }
  .ep-title,
  .trailer-title { color: var(--color-on-surface); }

  .episode-item:hover .ep-title,
  .trailer-item:hover .trailer-title { color: var(--color-warm); }

  .episode-item[aria-current='true'] .ep-num,
  .episode-item[aria-current='true'] .ep-title,
  .trailer-item[aria-current='true'] .trailer-title { color: var(--color-warm); }

  /* El badge existe en todos los ítems; sólo se ve en el activo.
     display:none lo saca también del árbol de accesibilidad, así que un
     lector de pantalla no lo lee 12 veces. */
  .now-playing-badge { display: none; }
  .episode-item[aria-current='true'] .now-playing-badge { display: inline-block; }

  .episode-item:focus-visible,
  .trailer-item:focus-visible {
    outline: 2px solid var(--color-warm);
    outline-offset: 2px;
  }
</style>

{(playlistId || trailer) && (
  <script define:vars={{ playlistId, trailerVideoId: trailer?.videoId ?? '' }}>
    const items = document.querySelectorAll('.episode-item');
    const trailerItem = document.querySelector('.trailer-item');
    const player = document.getElementById('yt-player');
    const playerSection = document.getElementById('yt-player-section');
    const origin = window.location.origin;

    function activateItem(activeEl) {
      // Un único marcador de estado: el CSS reacciona a aria-current.
      // Cualquier elemento que deba cambiar con el estado activo se
      // resuelve con una regla CSS, no tocándolo desde acá.
      items.forEach((el) => el.removeAttribute('aria-current'));
      trailerItem?.removeAttribute('aria-current');
      activeEl.setAttribute('aria-current', 'true');
    }

    function onKey(handler) {
      return (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handler();
        }
      };
    }

    // Episode clicks
    items.forEach((item) => {
      const handleEpisodeActivate = () => {
        const videoId = item.dataset.videoId;
        const index = item.dataset.index;

        if (!player) return;

        if (videoId) {
          player.src = `https://www.youtube-nocookie.com/embed/${videoId}?list=${playlistId}&origin=${origin}&autoplay=1`;
        } else {
          player.src = `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}&index=${index}&origin=${origin}&autoplay=1`;
        }

        activateItem(item);

        if (window.innerWidth < 1024) {
          playerSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      item.addEventListener('click', handleEpisodeActivate);
      item.addEventListener('keydown', onKey(handleEpisodeActivate));
    });

    // Trailer click
    if (trailerItem && trailerVideoId) {
      const handleTrailerActivate = () => {
        if (!player) return;

        // Trailer is not part of the playlist — embed without list param
        player.src = `https://www.youtube-nocookie.com/embed/${trailerVideoId}?origin=${origin}&autoplay=1`;

        activateItem(trailerItem);

        if (window.innerWidth < 1024) {
          playerSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      trailerItem.addEventListener('click', handleTrailerActivate);
      trailerItem.addEventListener('keydown', onKey(handleTrailerActivate));
    }
  </script>
)}
