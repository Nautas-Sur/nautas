---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CelestialLine from '../components/CelestialLine.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectCover } from '../lib/projectCover';
import { em } from '../lib/emphasis';

const locale = Astro.currentLocale || 'es';
const page = await getEntry('pages', 'proyectos');
const d = page?.data;
const t = (f?: { es: string; en: string }) => f?.[locale] ?? '';

const projects = await getCollection('projects');
const completed = projects.filter((p) => p.data.status === 'completed');
const inDev = projects.filter((p) => p.data.status === 'in_development');
---

<BaseLayout
  title={t(d?.title) ?? ''}
  description={t(d?.description) ?? ''}
  locale={locale}
>
  <HeroSection
    variant="default"
    eyebrow={t(d?.hero_eyebrow)}
    title={em(t(d?.hero_title)) ?? ''}
    subtitle={t(d?.hero_subtitle)}
  />

  <CelestialLine />

  <!-- Completed -->
  {completed.length > 0 && (
    <section class="max-w-[1440px] mx-auto px-6 md:px-12 mb-32">
      <h2 class="font-headline text-4xl md:text-5xl mb-12 [&_em]:not-italic [&_em]:text-primary" set:html={em(t(d?.completed_title)) ?? (locale === 'en' ? 'Productions' : 'Producciones')} />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {completed.map((p) => (
          <ProjectCard
            title={p.data.title}
            slug={p.id}
            kind={p.data.kind}
            pillar={p.data.pillar}
            tagline={locale === 'en' ? p.data.tagline.en : p.data.tagline.es}
            year={p.data.year}
            episodeCount={p.data.episodes?.length}
            image={getProjectCover(p.data)}
            status="completed"
            locale={locale}
          />
        ))}
      </div>
    </section>
  )}

  <CelestialLine />

  <!-- In Development -->
  {inDev.length > 0 && (
    <section class="max-w-[1440px] mx-auto px-6 md:px-12 mb-20">
      <h2 class="font-headline text-4xl md:text-5xl mb-12 [&_em]:not-italic [&_em]:text-primary" set:html={em(t(d?.in_dev_title)) ?? (locale === 'en' ? 'In Development' : 'En Desarrollo')} />
      <div class="grid md:grid-cols-2 gap-6">
        {inDev.map((p) => (
          <ProjectCard
            title={p.data.title}
            slug={p.id}
            kind={p.data.kind}
            pillar={p.data.pillar}
            tagline={locale === 'en' ? p.data.tagline.en : p.data.tagline.es}
            image={getProjectCover(p.data)}
            status="in_development"
            locale={locale}
            variant="horizontal"
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
