---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../HeroSection.astro';
import CelestialLine from '../CelestialLine.astro';
import ProjectCard from '../ProjectCard.astro';
import { getProjectCover } from '../../lib/projectCover';
import { sortProjects } from '../../lib/sortProjects';
import { em } from '../../lib/emphasis';

const locale = Astro.currentLocale || 'es';
const page = await getEntry('pages', 'proyectos');
const d = page?.data;
const ui = await getEntry('ui', 'textos');
const t = (f?: { es: string; en: string }) => f?.[locale] || undefined;

const projects = sortProjects(await getCollection('projects'));
---

<BaseLayout
  title={t(d?.title) ?? ''}
  description={t(d?.description) ?? ''}
  locale={locale}
>
  <HeroSection
    variant="default"
    eyebrow={t(d?.hero_eyebrow)}
    title={em(t(d?.hero_title)) ?? ''}
    subtitle={em(t(d?.hero_subtitle))}
    subtitleReadMore={true}
    readMoreLabel={t(ui?.data.read_more) ?? (locale === 'en' ? 'read more' : 'leer más')}
    readLessLabel={t(ui?.data.read_less) ?? (locale === 'en' ? 'read less' : 'leer menos')}
  />

  <CelestialLine class="mt-4 mb-8 md:mt-6 md:mb-12" />

  <!-- Producciones -->
  {projects.length > 0 && (
    <section class="max-w-[1440px] mx-auto px-6 md:px-12 mb-section">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((p) => (
          <ProjectCard
            title={p.data.title}
            slug={p.id}
            kind={p.data.kind}
            pillar={p.data.pillar}
            tagline={locale === 'en' ? p.data.tagline.en : p.data.tagline.es}
            year={p.data.year}
            episodeCount={p.data.episodes?.length}
            image={getProjectCover(p.data)}
            imageAlt={p.data.heroAlt || p.data.title}
            status={p.data.status}
            locale={locale}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
